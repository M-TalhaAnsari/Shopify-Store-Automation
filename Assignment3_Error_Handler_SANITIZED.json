    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst exec = data.execution || {};\nconst wf = data.workflow || {};\nconst err = exec.error || {};\nconst ts = new Date().toLocaleString('en-PK', { timeZone: 'Asia/Karachi', hour12: true });\n\nconst message = [\n  '🚨 *WORKFLOW ERROR ALERT*',\n  '',\n  '*Workflow:* ' + (wf.name || 'Order-to-Fulfillment Automation'),\n  '*Failed Node:* ' + (err.node ? err.node.name : (exec.lastNodeExecuted || 'Unknown')),\n  '*Error:* ' + (err.message || err.description || 'Unexpected execution failure'),\n  '*Execution ID:* ' + (exec.id || 'N/A'),\n  '*Time (PKT):* ' + ts,\n  exec.url ? '*Execution URL:* ' + exec.url : '',\n  '',\n  '⚠️ Please inspect n8n and process any affected order manually.',\n].filter(Boolean).join('\\n');\n\nreturn [{\n  json: {\n    chatId: data.owner_telegram_chat_id,\n    message,\n  },\n}];"
      },
      "id": "59eed32d-db16-4ec3-81ed-1efaf6e4f602",
      "name": "Format Error Alert",
